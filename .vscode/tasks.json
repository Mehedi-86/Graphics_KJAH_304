    {
      "type": "shell",
      "label": "Clean OpenGL Project",
      "command": "make clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Remove compiled objects and binary"
    }
  ]
